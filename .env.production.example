# ==============================================================================
# Placement Intelligence Platform — Production Environment Configuration
# ==============================================================================
# Copy this file to .env.production on your deployment server and populate
# with real, secure credentials. Never commit production secrets to Git.

# ------------------------------------------------------------------------------
# Spring Profile & Server
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.x)
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://<DB_HOST>:3306/<DB_NAME>?useSSL=true&serverTimezone=UTC
DB_USERNAME=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

# ------------------------------------------------------------------------------
# JWT Authentication & Tokens
# ------------------------------------------------------------------------------
# Secure HMAC-SHA256 signing secret (minimum 256-bit / 32 characters)
JWT_SECRET=<YOUR_SECURE_256BIT_SECRET>
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ------------------------------------------------------------------------------
# OTP & File Storage
# ------------------------------------------------------------------------------
OTP_EXPIRATION_SECONDS=300
RESUME_STORAGE_DIR=/app/uploads/resumes

# ------------------------------------------------------------------------------
# CORS & Networking
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. https://placement.example.com)
CORS_ALLOWED_ORIGINS=https://placement.example.com

# ------------------------------------------------------------------------------
# Frontend Public API Base URL (Used at build/runtime by Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.placement.example.com/api

# ------------------------------------------------------------------------------
# Docker Compose Simulation / Staging (Only if running self-hosted MySQL container)
# ------------------------------------------------------------------------------
MYSQL_DATABASE=placement_intelligence
MYSQL_USER=placement_app
MYSQL_PASSWORD=<DB_PASSWORD>
MYSQL_ROOT_PASSWORD=<DB_ROOT_PASSWORD>
